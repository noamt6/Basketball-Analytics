# Normalize to LF in the repo (the batch image + CI run on Linux; a CRLF
# docker-entrypoint.sh would break its shebang).
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.tf   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.sql  text eol=lf
Makefile text eol=lf

*.xlsx binary
*.png  binary
*.woff2 binary
*.ipynb -text
