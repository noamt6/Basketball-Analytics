# ---------------------------------------------------------------------------
# Local / Docker Postgres (the day-to-day dev path). Copy to .env and edit.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics_db
DB_USER=postgres
DB_PASSWORD=postgres

# TLS mode passed to psycopg2: disable | allow | prefer | require | verify-full.
# Local Postgres: disable. AWS RDS: require (or verify-full with DB_SSLROOTCERT).
DB_SSLMODE=disable
# DB_SSLROOTCERT=/path/to/eu-central-1-bundle.pem   # only for verify-full

# ---------------------------------------------------------------------------
# AWS path — when this is set, db_client.py ignores the DB_* vars above and
# reads {host,port,dbname,username,password} from AWS Secrets Manager instead.
# The Terraform in infra/ creates the secret and outputs its ARN.
# ---------------------------------------------------------------------------
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:<acct>:secret:bball/db-XXXXXX
# AWS_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------
# Season tag applied to the rows this run ingests (the workbook has no season
# column). One run = one season.
SEASON=2023-2024
# Workbook to ingest. Unset = the bundled data/Basketball_Analytics.xlsx.
# Also settable with `python ingest.py --workbook /path/to/next-season.xlsx`.
# WORKBOOK=data/Basketball_Analytics.xlsx
